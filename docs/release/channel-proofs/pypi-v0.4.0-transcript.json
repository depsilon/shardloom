          "-I",
          "-c",
          "\nimport json, os\nfrom pathlib import Path\nimport shardloom as sl\nfrom shardloom import ShardLoomClient\nassert not any(k.startswith('SHARDLOOM_') for k in os.environ)\nassert '/site-packages/' in sl.__file__\nassert sl.__version__ == '0.4.0'\nclient = ShardLoomClient.from_env()\ntry:\n    # Inspect resolution before executing anything, so a missing bundled CLI\n    # cannot be replaced by the host installation even for the initial smoke.\n    resolved = Path(client._resolved_binary()).resolve()\n    assert '/site-packages/shardloom/bin/' in str(resolved), resolved\n    smoke = client.smoke_check()\n    assert Path(smoke.resolved_cli_path).resolve() == resolved\n    assert smoke.cli_version == '0.4.0' and not smoke.fallback_attempted\n    ctx = sl.context(client=client)\n    source = Path('orders.csv').resolve()\n    assert not source.exists()\n    source.write_text('id,label,amount\\n1,alpha,8\\n2,\u03b2eta \u96ea,15\\n3,gamma \ud83e\uddf5,27\\n')\n    expected = [{'id':2,'label':'\u03b2eta \u96ea','amount':15}, {'id':3,'label':'gamma \ud83e\uddf5','amount':27}]\n    frames = [ctx.read(source).filter(sl.col('amount') >= 10).select('id','label','amount').limit(2)]\n    frames += [ctx.sql(f\"SELECT id, label, amount FROM '{source}' WHERE amount >= 10 LIMIT 2\") for _ in range(2)]\n    actual = []\n    for frame in frames:\n        result = frame.collect()\n        assert result.runtime_execution and result.status == 'success' and result.output_row_count == 2\n        assert not result.fallback_attempted and not result.external_engine_invoked\n        values = [dict(row) for row in result.result_rows]\n        assert values == expected\n        assert all(type(row['id']) is int and type(row['amount']) is int and type(row['label']) is str for row in values)\n        actual.append(values)\n    framed = ctx.sql(f\"SELECT id, COUNT(*) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS n, FIRST_VALUE(label) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS first_label FROM '{source}' ORDER BY id\").collect()\n    assert framed.runtime_execution and framed.status == 'success' and framed.output_row_count == 3\n    assert not framed.fallback_attempted and not framed.external_engine_invoked\n    frame_values = [dict(row) for row in framed.result_rows]\n    assert frame_values == [{'id': 1, 'n': 1, 'first_label': 'alpha'},\n                            {'id': 2, 'n': 2, 'first_label': 'alpha'},\n                            {'id': 3, 'n': 2, 'first_label': '\u03b2eta \u96ea'}]\n    assert all(type(row['id']) is int and type(row['n']) is int for row in frame_values)\n    output = Path('orders.vortex').resolve()\n    written = ctx.read(source).write_vortex(output)\n    assert written.runtime_execution and written.status == 'success'\n    assert not written.fallback_attempted and not written.external_engine_invoked\n    assert output.is_file() and output.stat().st_size > 0\n    reopened = ctx.read(output).collect()\n    assert reopened.runtime_execution and reopened.status == 'success' and reopened.output_row_count == 3\n    assert not reopened.fallback_attempted and not reopened.external_engine_invoked\n    reopened_values = [dict(row) for row in reopened.result_rows]\n    assert reopened_values == [{'id': 1, 'label': 'alpha', 'amount': 8}, *expected]\n    denied = ctx.read(source).select('id').to_pandas()\n    assert denied.blocker_id and not denied.runtime_execution\n    assert not denied.fallback_attempted and not denied.external_engine_invoked\n    print(json.dumps({'package_path':sl.__file__, 'resolved_cli_path':str(resolved),\n        'cli_version':smoke.cli_version, 'exact_results':actual,\n        'analytic_frame_values':frame_values, 'native_vortex_roundtrip_values':reopened_values,\n        'unsupported_blocker':denied.blocker_id, 'fallback_attempted':False,\n        'external_engine_invoked':False}))\nfinally:\n    client.close()\n"
        ],
