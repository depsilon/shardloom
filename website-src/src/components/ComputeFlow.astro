---
const flows = [
  {
    id: "group", label: "Filter & group", title: "Count matching rows by category",
    query: "Filter a date range → group by category → count",
    stages: [
      ["Use valid source data", "Reuse a validated Vortex file, or load a supported local input. Each query computes a fresh result.", "Source → Vortex", "full"],
      ["Read less", "Exact segment statistics can rule out data outside the filter. Read the columns and segments still needed.", "Segment pruning", "prune"],
      ["Work on the encoding", "Eligible dictionary grouping combines encoded identities and exact counts. Referenced values are decoded only where required.", "Encoded aggregation", "encoded"],
      ["Return the result", "Resolve the surviving group values and deliver the complete result with execution details.", "Late materialization", "result"],
    ],
    control: "Work scheduling (PulseWeave) divides supported operations into bounded execution tasks. Memory and parallelism settings constrain work in flight.",
    takeaway: "Less source data read. Less repeated text expanded. One result.",
  },
  {
    id: "count", label: "Metadata count", title: "Count all rows in a Vortex file",
    query: "Vortex file → unfiltered row count",
    stages: [
      ["Validate the source", "Open the supported Vortex source and check its identity. An unchanged prepared source can reuse retained handles.", "Source identity", "full"],
      ["Answer from metadata", "For an eligible exact row count, use file metadata. No data-column payload needs to be read.", "Metadata only", "result"],
      ["Skip the scan", "This metadata answer needs no column-data decoding, row construction, or aggregation workers.", "Payload work bypassed", "bypass"],
      ["Return one value", "Return the exact count and evidence identifying the metadata answer. Filters or other measures can require reading column data in the same engine.", "Exact result", "result"],
    ],
    control: "Queries answered from metadata avoid column-data reads and aggregation workers. Serving policies can explicitly reserve capacity for metadata work.",
    takeaway: "The fastest stage is the one the query does not need.",
  },
  {
    id: "topk", label: "Ordered top-K", title: "Find the first K rows in an exact order",
    query: "Vortex file → order by supported keys → limit K",
    stages: [
      ["Start from Vortex", "Use an existing Vortex file or validated loaded data. The source must remain unchanged throughout execution.", "Vortex source", "full"],
      ["Read the ordering keys", "Inspect the keys required to select winners. Valid key bounds can rule out segments; other segments must still be considered.", "Key-first scan", "prune"],
      ["Keep exact winners", "Supported top-K operations retain candidate keys and row positions, deferring full values until the winners are known.", "Exact selection", "encoded"],
      ["Gather winning payload", "Fetch the requested values for selected rows, preserve the query’s order, and return the result through a supported output adapter.", "Late payload gathering", "result"],
    ],
    control: "Memory, parallelism, and I/O controls bound supported execution. Spill support depends on the operator; unsupported resource requirements return a diagnostic.",
    takeaway: "Decide which rows win before gathering their payload.",
  },
];
---

<shardloom-compute-flow class="compute-flow not-content">
  <fieldset class="flow-picker" hidden>
    <legend>Explore a query example</legend>
    <div class="flow-options">
      {flows.map((flow, index) => (
        <label>
          <input type="radio" name="compute-flow" value={flow.id} checked={index === 0} aria-controls={`flow-${flow.id}`} />
          <span>{flow.label}</span>
        </label>
      ))}
    </div>
  </fieldset>
  {flows.map((flow) => (
    <section id={`flow-${flow.id}`} class="flow-panel" aria-labelledby={`flow-title-${flow.id}`}>
      <div class="flow-intro">
        <p class="flow-kicker">ShardLoom engine · query example</p>
        <h2 id={`flow-title-${flow.id}`}>{flow.title}</h2>
        <p class="flow-query">{flow.query}</p>
      </div>
      <ol class="flow-stages">
        {flow.stages.map(([title, description, mechanism, pattern], index) => (
          <li class:list={['flow-stage', { 'is-bypass': pattern === 'bypass' }]}>
            <span class="flow-number" aria-hidden="true">0{index + 1}</span>
            <div class="flow-stage-copy">
              <span class="flow-mechanism">{mechanism}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
            <div class:list={['flow-cells', `pattern-${pattern}`]} aria-hidden="true">
              {Array.from({length: 12}, (_, cell) => <span class:list={{ kept: pattern === 'full' || (pattern === 'prune' && cell % 3 === 0) || (pattern === 'encoded' && cell < 3) || (pattern === 'result' && cell === 0) }} />)}
            </div>
          </li>
        ))}
      </ol>
      <div class="flow-control"><span>Resource control</span><p>{flow.control}</p></div>
      <p class="flow-takeaway">{flow.takeaway}</p>
    </section>
  ))}
  <p class="flow-caption">Conceptual illustrations of the ShardLoom engine. Each example shows the work its query needs. The tiles are visual cues, not measured row counts or runtime telemetry. Actual execution depends on the query, types, layout, and enabled features.</p>
</shardloom-compute-flow>

<script>
  class ShardLoomComputeFlow extends HTMLElement {
    connectedCallback() {
      const picker = this.querySelector<HTMLFieldSetElement>('.flow-picker');
      const panels = this.querySelectorAll<HTMLElement>('.flow-panel');
      if (!picker) return;
      const update = () => {
        const selected = picker.querySelector<HTMLInputElement>('input:checked');
        if (!selected) return;
        for (const panel of panels) panel.hidden = panel.id !== `flow-${selected.value}`;
      };
      const revealLinkedPanel = () => {
        let fragment;
        try { fragment = decodeURIComponent(window.location.hash.slice(1)); }
        catch { return; }
        const target = document.getElementById(fragment);
        if (!target) return;
        const panel = [...panels].find((entry) => entry.contains(target));
        if (!panel) return;
        for (const input of picker.querySelectorAll<HTMLInputElement>('input')) {
          input.checked = panel.id === `flow-${input.value}`;
        }
        update();
      };
      picker.addEventListener('change', update);
      update();
      revealLinkedPanel();
      window.addEventListener('hashchange', revealLinkedPanel);
      picker.hidden = false;
    }
  }
  if (!customElements.get('shardloom-compute-flow')) {
    customElements.define('shardloom-compute-flow', ShardLoomComputeFlow);
  }
</script>

<style>
  .compute-flow { display: block; margin-block: 2rem; }
  .compute-flow [hidden] { display: none; }
  .flow-picker { border: 0; padding: 0; margin: 0 0 1.5rem; min-width: 0; }
  .flow-picker legend { padding: 0; margin-bottom: .65rem; font-size: .85rem; color: var(--sl-color-gray-2); }
  .flow-options { display: flex; flex-wrap: wrap; gap: .5rem; }
  .flow-options label { position: relative; cursor: pointer; }
  .flow-options input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .flow-options span { display: flex; align-items: center; min-height: 44px; padding: .55rem .85rem; border: 1px solid var(--sl-color-gray-4); border-radius: 4px; font-size: .85rem; color: var(--sl-color-gray-2); }
  .flow-options input:checked + span { color: var(--sl-color-white); border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
  .flow-options input:focus-visible + span { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }
  .flow-intro { padding: 1.6rem; border: 1px solid var(--sl-color-hairline-light); border-bottom: 0; background: var(--sl-color-gray-6); }
  .flow-kicker { font: .65rem var(--sl-font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--sl-color-accent); margin: 0 0 .7rem; }
  .flow-intro h2 { font-size: 1.4rem; line-height: 1.25; margin: 0; }
  .flow-query { font: .8rem/1.65 var(--sl-font-mono); color: var(--sl-color-gray-2); margin: .75rem 0 0; }
  .flow-stages { list-style: none; padding: 0; margin: 0; }
  .flow-stage { position: relative; display: grid; grid-template-columns: 2rem minmax(0, 1fr) 4.5rem; gap: 1rem; align-items: start; padding: 1.45rem 1.6rem; border: 1px solid var(--sl-color-hairline-light); border-top-style: dashed; }
  .flow-stage + .flow-stage { border-top: 0; }
  .flow-number { font: .75rem var(--sl-font-mono); color: var(--sl-color-accent); padding-top: .15rem; }
  .flow-stage:not(:last-child)::after { content: ''; position: absolute; bottom: -.2rem; left: 1.9rem; z-index: 1; width: .4rem; height: .4rem; border-left: 1px solid var(--sl-color-gray-3); border-bottom: 1px solid var(--sl-color-gray-3); transform: rotate(-45deg); background: var(--sl-color-bg); }
  .flow-mechanism { display: block; font: .65rem/1.5 var(--sl-font-mono); color: var(--sl-color-accent); text-transform: uppercase; letter-spacing: .04em; }
  .flow-stage h3 { font-size: 1.1rem; margin: .3rem 0 .5rem; line-height: 1.25; }
  .flow-stage p { font-size: .85rem; line-height: 1.6; color: var(--sl-color-gray-2); margin: 0; }
  .flow-cells { display: grid; grid-template-columns: repeat(3, 1fr); gap: .3rem; margin-top: .3rem; }
  .flow-cells span { height: .8rem; border: 1px solid var(--sl-color-gray-4); opacity: .35; border-radius: 1px; }
  .flow-cells .kept { background: var(--sl-color-accent); border-color: var(--sl-color-accent); opacity: 1; }
  .pattern-encoded .kept { grid-column: 1 / -1; height: .45rem; }
  .pattern-result .kept { grid-column: 1 / -1; height: 1rem; }
  .pattern-bypass span { border-style: dashed; }
  .is-bypass { background: var(--sl-color-gray-6); }
  .flow-control { padding: 1rem 1.6rem; border: 1px solid var(--sl-color-hairline-light); border-top: 0; background: var(--sl-color-accent-low); }
  .flow-control > span { font: .65rem var(--sl-font-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--sl-color-accent-high); }
  .flow-control p { margin: .35rem 0 0; font-size: .8rem; line-height: 1.6; }
  .flow-takeaway { font-size: .95rem; font-weight: 600; margin: 1rem 0; }
  .flow-caption { font-size: .75rem; line-height: 1.65; color: var(--sl-color-gray-2); margin: 0; }
  @media (max-width: 30rem) {
    .flow-intro, .flow-control { padding: 1.1rem; }
    .flow-stage { padding: 1.2rem 1rem; grid-template-columns: 1.35rem minmax(0, 1fr); gap: .65rem; }
    .flow-stage:not(:last-child)::after { left: 1.3rem; }
    .flow-cells { grid-column: 2; width: 4.5rem; margin-top: 0; }
    .flow-options span { padding-inline: .6rem; font-size: .78rem; }
  }
</style>
