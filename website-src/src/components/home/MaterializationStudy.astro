---
const bands = Array.from({ length: 8 }, (_, i) => i);
const cells = Array.from({ length: 6 }, (_, i) => i);
---

<section class="section paper materialization-section section-anchor" id="materialization" aria-labelledby="manifesto-title">
  <div class="wrap">
    <div class="materialization-layout">
      <div class="materialization-heading">
        <p class="eyebrow">05 / Materialization</p>
        <h2 id="manifesto-title">Keep more native.<br /><span class="soft">Materialize later.</span></h2>
        <p class="copy">Keep the representation that still serves the work. Decode, copy, or build rows where the operation or output requires it.</p>
        <a class="text-link" href="/field-guide/python-surface#keep-results-native">Follow the result boundary <span class="arrow">↗</span></a>
      </div>
      <div class="materialization-study" data-materialization="native">
        <div class="study-topline"><span>Representation study</span><span id="materializationReadout">01 / Native result</span></div>
        <div class="materialization-drawing">
          <svg viewBox="0 0 720 360" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="retainedPlate" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#c4dce3" stop-opacity=".9" /><stop offset="1" stop-color="#578194" stop-opacity=".12" /></linearGradient>
              <linearGradient id="materializationThread"><stop stop-color="#477184" stop-opacity=".12" /><stop offset=".5" stop-color="#477184" stop-opacity=".8" /><stop offset="1" stop-color="#477184" stop-opacity=".35" /></linearGradient>
            </defs>
            <path class="study-guide" d="M24 296H696M24 84H696" />
            <path class="materialization-boundary" d="M430 40V318" />
            <path class="materialization-bracket" d="M54 70V58H354V70M54 302V314H354V302" />
            {bands.map(i => <path d={`M60 ${130 + i * 13} C160 ${55 + i * 20} 314 ${246 - i * 12} 430 ${171 + i * 4}`} fill="none" stroke="url(#materializationThread)" stroke-width=".8" />)}
            <g class="retained-plates">
              {[3, 2, 1, 0].map(i => <g transform={`translate(0 ${i * 30})`}>
                <path d="M124 124 242 64 359 112 240 172Z" fill="url(#retainedPlate)" stroke="#5e8292" stroke-width=".8" />
                <path d="M124 124V137L240 185 359 125V112M240 172V185" fill="#7198a51a" stroke="#6a8d9a" stroke-width=".65" />
                {cells.map(j => <path d={`M${141 + j * 17} ${115 - j * 8.5}l89 37`} stroke="#3d697a" stroke-width={j % 3 === 0 ? 4 : 1} opacity={.17 + j * .045} />)}
              </g>)}
            </g>
            <g class="materialization-output output-native">
              {bands.map(i => <path d={`M430 ${171 + i * 4} Q476 ${169 + i * 5} 520 ${157 + i * 6}`} fill="none" stroke="#5e8292" stroke-width=".8" />)}
              {[2, 1, 0].map(i => <path d={`M508 ${155 + i * 26} 588 ${115 + i * 26} 666 ${148 + i * 26} 587 ${189 + i * 26}Z`} fill="url(#retainedPlate)" stroke="#537b8c" stroke-width=".8" />)}
            </g>
            <g class="materialization-output output-file">
              {bands.map(i => <path d={`M430 ${171 + i * 4} Q483 ${171 + i * 4} 548 ${129 + i * 16}`} fill="none" stroke="#5e8292" stroke-width=".8" />)}
              <path d="M548 91H618L650 123V277H548ZM618 91V123H650" fill="#dae5e6" stroke="#537b8c" />
              {bands.map(i => <path d={`M564 ${145 + i * 14}H${i % 3 === 0 ? 607 : 633}`} stroke="#537b8c" stroke-width={i % 3 === 0 ? 2 : 1} opacity=".65" />)}
            </g>
            <g class="materialization-output output-rows">
              {bands.map(i => <g>
                <path d={`M430 ${171 + i * 4} C484 ${171 + i * 4} 478 ${110 + i * 23} 527 ${110 + i * 23}`} fill="none" stroke="#5e8292" stroke-width=".8" />
                <path d={`M531 ${101 + i * 23}h137v17H531Z`} fill={i % 2 === 0 ? '#bed4da' : '#e4ebea'} stroke="#7494a0" stroke-width=".6" />
                <path d={`M553 ${101 + i * 23}v17m51-17v17`} stroke="#7494a0" stroke-width=".6" />
              </g>)}
            </g>
            <circle cx="430" cy="185" r="5" fill="#edf0ec" stroke="#466d7e" /><path d="M424 185h12M430 179v12" stroke="#466d7e" stroke-width=".7" />
          </svg>
          <div class="materialization-labels"><span>Retained representation</span><span id="materializationOutput">Native arrays</span></div>
        </div>
        <div class="study-switch materialization-switch" role="group" aria-label="Explore result boundaries">
          <button type="button" data-materialization-choice="native" aria-label="Inspect native result boundary" aria-pressed="true">Native result</button>
          <button type="button" data-materialization-choice="file" aria-label="Inspect typed file boundary" aria-pressed="false">Typed file</button>
          <button type="button" data-materialization-choice="rows" aria-label="Inspect Python rows boundary" aria-pressed="false">Python rows</button>
        </div>
        <div class="materialization-detail" aria-live="polite"><strong id="materializationTitle">Keep ownership with the result.</strong><p id="materializationDescription">Supported in-process results retain native arrays and their memory credits. Chaining can use those arrays without first building Python rows.</p></div>
      </div>
    </div>
    <div class="materialization-foot"><span class="mono">Decode only where required</span><p>General computed results can still use bounded scalar-to-native construction. This illustration shows representation boundaries, not a zero-decode guarantee.</p></div>
  </div>
</section>
