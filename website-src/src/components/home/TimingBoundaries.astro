<div class="timing-boundaries" data-timing-boundary="runtime">
  <div class="timing-heading"><span class="mono">The work behind the timing</span><span class="mono" id="timingSurface">Engine execution</span></div>
  <div class="timing-track" role="group" aria-label="Timing boundaries">
    <button type="button" data-timing="runtime" aria-label="Engine execution measurement" data-included="true" aria-pressed="true"><span class="timing-marker" aria-hidden="true"></span><span>Engine execution</span></button>
    <button type="button" data-timing="replay" aria-label="Loading and preparation work" data-included="false" aria-pressed="false"><span class="timing-marker" aria-hidden="true"></span><span>Loading and preparation</span></button>
    <button type="button" data-timing="publication" aria-label="Result validation work" data-included="false" aria-pressed="false"><span class="timing-marker" aria-hidden="true"></span><span>Result validation</span></button>
  </div>
  <p class="timing-description" id="timingDescription" aria-live="polite">The engine computes the answer. Routine query timing excludes separate loading, preparation, validation, and report generation.</p>
</div>
