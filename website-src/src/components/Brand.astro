---
interface Props { href?: string; class?: string }
const { href = "/", class: className = "" } = Astro.props;
---

<a class:list={["shardloom-brand", className]} href={href} aria-label="ShardLoom home">
  <svg viewBox="0 0 24 30" width="24" height="30" aria-hidden="true">
    <path d="M12 1 23 14 12 29 1 14Z" fill="none" stroke="#c6e5fd" stroke-width=".9" />
    <path d="m12 1-4 13 4 15 5-15Zm-11 13h22M8 14l9 0" fill="none" stroke="#94badb" stroke-width=".7" />
    <path d="m12 1 5 13-9 0Z" fill="#d0eaff" opacity=".25" />
  </svg>
  <span>ShardLoom<sup>°</sup></span>
</a>

<style>
  .shardloom-brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #edf4f9;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 21px;
    font-weight: 630;
    letter-spacing: -.055em;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
  }
  svg { display: block; flex: 0 0 auto; width: 23px; height: 28px; }
  sup { margin-left: 2px; font-size: 12px; vertical-align: top; color: #badcff; }
  a:hover { color: #badcff; }
  a:focus-visible { outline: 2px solid #badcff; outline-offset: 5px; }
</style>
