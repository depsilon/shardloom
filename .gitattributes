# Benchmark evidence bundles are generated by scripts/promote_benchmark_artifact.py.
website/assets/benchmarks/latest/** linguist-generated=true
website-public/assets/benchmarks/latest/** linguist-generated=true
website/assets/data/benchmark-evidence.json linguist-generated=true
website-public/assets/data/benchmark-evidence.json linguist-generated=true
website-src/src/data/benchmark-evidence.json linguist-generated=true
website-src/src/data/benchmark-manifest.json linguist-generated=true

# Preserve the hash-bound timing evidence CSV's standard CRLF record endings.
docs/benchmarks/evidence/native-query-timing-uat-2026-10-15.csv -text whitespace=cr-at-eol

# Keep this portable guarantee packet and its hash-bound records byte-exact.
docs/benchmarks/evidence/perf12-guarantees-2026-10-22/** -text

# Preserve upstream legal texts byte-for-byte, including original line endings
# and whitespace. Their content hashes are verified by the license manifest.
python/THIRD_PARTY_LICENSES/texts/*.txt -text -whitespace linguist-vendored=true

# Keep the reviewed registry imports byte-exact and distinguish upstream code.
vendor/arrow-ipc/** -text linguist-vendored=true
vendor/orc-rust/** -text linguist-vendored=true
vendor/parquet/** -text linguist-vendored=true
# These unchanged upstream documents include whitespace bound by provenance.
vendor/orc-rust/README.md -whitespace
vendor/parquet/src/bin/parquet-fromcsv-help.txt -whitespace

# Keep historical proof payloads in Git, outside install source archives.
/docs/benchmarks/evidence/**/*.xz export-ignore
/docs/benchmarks/evidence/**/*.gz export-ignore
/docs/benchmarks/evidence/**/*.part-* export-ignore
/docs/benchmarks/compiler-profile-screen-2026-09-27.json.gz export-ignore
/docs/benchmarks/json-typed-builder-screen-2026-09-27.json.gz export-ignore
/docs/benchmarks/jsonl-typed-builder-screen-2026-09-27.json.gz export-ignore
/docs/benchmarks/portable-release-acceptance-2026-09-27.json.gz export-ignore
